# Project Generator - Variables de Entorno
# Copia este archivo a .env y rellena los valores
# (en GitHub Actions van como secrets, ver ../SECRETS.md)

# ============================================
# TELEGRAM (OBLIGATORIO)
# ============================================
# Token del bot de Telegram (obténlo en @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Channel ID del canal "reportes proyectos"
# Obténlo con: python -m src.get_channel_id "reportes proyectos"
TELEGRAM_REPORTS_PROYECTOS_CHANNEL_ID=-1001234567890

# ============================================
# IA (OBLIGATORIO)
# ============================================
GEMINI_API_KEY=...

# Modelo a usar (solo modelos 2.x; el sistema usa system_instruction)
AI_MODEL=gemini-2.5-flash

# Si es false, un fallo de Gemini hace fallar el workflow en vez de
# recurrir al proveedor determinista (recomendado en CI)
ALLOW_DETERMINISTIC_FALLBACK=true

# ============================================
# CONFIGURACIÓN GENERACIÓN
# ============================================
# Proyectos por ejecución
PROJECTS_PER_RUN=3

# Scraper tuweb.dev
SCRAPE_TUWEB_DEV=true
TUWEB_DEV_URL=https://tuweb.dev/

# BD local de tips usada como inspiración (opcional, ruta absoluta)
TIPS_DATABASE_PATH=

# Directorio de datos
DATA_DIR=./data
HISTORY_FILE=generated_projects.json

# ============================================
# SCHEDULER (informativo)
# ============================================
# El cron real está en .github/workflows/generate-projects.yml
CRON_SCHEDULE=0 */4 * * *
