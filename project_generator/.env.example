# Project Generator - Variables de Entorno
# Copia este archivo a .env y rellena los valores

# ============================================
# TELEGRAM (OBLIGATORIO)
# ============================================
# Token del bot de Telegram (obténlo en @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Channel ID del canal "reportes proyectos" 
# Obténlo con: python -m src.main test-telegram
# O ejecuta: python get_channel_id.py "reportes proyectos" en downloader_telegram
TELEGRAM_REPORTS_PROYECTOS_CHANNEL_ID=-1001234567890

# ============================================
# IA PROVIDER (AL MENOS UNO OBLIGATORIO)
# ============================================
# Proveedor: openai, anthropic, gemini, deterministic
AI_PROVIDER=openai

# Modelo a usar
AI_MODEL=gpt-4o-mini

# API Keys (solo necesitas la de tu proveedor elegido)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...

# ============================================
# CONFIGURACIÓN GENERACIÓN
# ============================================
# Proyectos por ejecución
PROJECTS_PER_RUN=5

# Scraper tuweb.dev (opcional)
SCRAPE_TUWEB_DEV=true
TUWEB_DEV_URL=https://tuweb.dev/

# Directorio de datos
DATA_DIR=./data
HISTORY_FILE=generated_projects.json

# ============================================
# SCHEDULER (para uso standalone)
# ============================================
# Cron expression (default: lunes 9am)
CRON_SCHEDULE=0 9 * * 1